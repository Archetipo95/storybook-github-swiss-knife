{
  "name": "storybook-github-swiss-knife",
  "version": "0.1.0",
  "description": "Storybook on GitHub: Pages deploys, PR previews, visual regression and accessibility checks",
  "main": "src/config.js",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.js",
    "lint": "eslint src/ test/*.test.js runner/ scripts/ packages/addon/",
    "format": "prettier --check \"**/*.{js,jsx,cjs,mjs,json,yml,yaml,md}\"",
    "format:fix": "prettier --write \"**/*.{js,jsx,cjs,mjs,json,yml,yaml,md}\"",
    "prepare-release": "node scripts/prepare-release.js",
    "validate-artifact": "node src/validate-artifact.js",
    "validate-config": "node src/config.js",
    "generate-badges": "node src/generate-badges.js",
    "test:fixture": "node scripts/fixture-e2e.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Archetipo95/storybook-github-swiss-knife.git"
  },
  "keywords": [
    "accessibility",
    "axe",
    "deployment",
    "github-actions",
    "github-pages",
    "playwright",
    "reusable-workflow",
    "storybook",
    "visual-regression"
  ],
  "author": "Archetipo95",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  },
  "private": true
}
